{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "客户流失预警清单",
  "version": "0.1.0",
  "identifier": "com.campfirecode.wecomchurnalert",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "客户流失预警清单",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "label": "main",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "篝火 campfire-code",
    "copyright": "Copyright © 2026 篝火（campfire-code）· MIT License",
    "category": "Productivity",
    "shortDescription": "客户流失预警清单",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "wecom-churn-alert"
}
